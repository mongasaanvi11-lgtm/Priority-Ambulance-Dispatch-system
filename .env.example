GEMINI_API_KEY=PASTE_YOUR_KEY_LOCALLY
GEMINI_MODEL=SET_TO_A_SUPPORTED_MODEL

# Optional: multiple keys for higher throughput and automatic 429 failover.
# Comma-separated. Separate free-tier quotas require separate Google accounts /
# projects -- multiple keys inside one project share a single quota.
# GEMINI_API_KEYS=AIza...,AIza...,AIza...

# Panel research tuning
# PANEL_RESEARCH_MODEL=gemini-3.1-flash-lite
# PANEL_RESEARCH_BATCH=20
# PANEL_CACHE_TTL_HOURS=720
# PANEL_SEARCH_GROUNDING=0
